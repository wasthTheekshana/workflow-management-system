NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=workflow
DB_PASSWORD=workflow_dev_password
DB_NAME=workflow_engine
DB_NAME_TEST=workflow_engine_test
DB_SSL=false

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h

CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Document storage: "local" (disk / mounted NAS) or "s3" (AWS S3, MinIO, any S3-compatible store).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Only used when STORAGE_DRIVER=s3. For AWS leave S3_ENDPOINT empty and prefer an IAM role
# over keys. For MinIO set S3_ENDPOINT (e.g. http://minio:9000) and S3_FORCE_PATH_STYLE=true.
# S3_BUCKET=workflow-documents
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
# Set to false only for a local dev relay (e.g. Mailhog) that doesn't support STARTTLS.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

ONLYOFFICE_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8082
ONLYOFFICE_CALLBACK_BASE_URL=http://host.docker.internal:3000

# --- docker compose only (backend/docker-compose.yml) ---
# Host-side ports for the api/frontend containers, and the URL the frontend's
# build bakes in for talking to the api container. Override here if the
# defaults (3001/5174) conflict with something else on your machine — the
# containers' internal ports never change.
# BACKEND_PORT=3001
# FRONTEND_PORT=5174
# VITE_API_BASE_URL=http://localhost:3001
# VITE_ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8082
