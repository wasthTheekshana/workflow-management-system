# Copy to deploy/.env on the server. NEVER commit the real file.

# --- domains (A records -> 34.93.171.14) ---
APP_DOMAIN=wk.testsys.shop
OFFICE_DOMAIN=wk-office.testsys.shop

# --- database ---
DB_USER=workflow_app
DB_PASSWORD=CHANGE_ME_long_random
DB_NAME=workflow
DB_SSL=false

# --- secrets (each at least 32 chars: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1h
ONLYOFFICE_JWT_SECRET=CHANGE_ME
# Pinned OnlyOffice version from hub.docker.com/r/onlyoffice/documentserver/tags (never latest)
ONLYOFFICE_TAG=CHANGE_ME_pinned_version

# --- first admin (created once by the seed; min 12 char password; change it after first login) ---
ADMIN_EMAIL=admin@example.lk
ADMIN_PASSWORD=CHANGE_ME_min_12_chars
TENANT_NAME=DOK Solutions Lanka

# --- URLs ---
CORS_ORIGINS=https://wk.testsys.shop
FRONTEND_BASE_URL=https://wk.testsys.shop
# OnlyOffice reaches the api over the private network; hostnames here are the
# only ones the save-callback trusts, so keep them matching.
ONLYOFFICE_DOCUMENT_SERVER_URL=https://wk-office.testsys.shop
ONLYOFFICE_CALLBACK_BASE_URL=http://workflow-api:3000

# --- document storage: Cloudflare R2 (S3-compatible) ---
STORAGE_DRIVER=s3
S3_BUCKET=workflow-documents
S3_REGION=auto
S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# --- email ---
SMTP_HOST=smtp.example.lk
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.lk
